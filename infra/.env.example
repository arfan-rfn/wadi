# Wadi configuration (§13): every setting is a WADI_* env var; these are the
# knobs a local operator most commonly touches. Full list: libs/wadi-config.

# --- Host ports (the WADI keypad block; loopback-bound) ---
#WADI_API_PORT=9234
#WADI_UI_PORT=9235
#WADI_MCP_PORT=9236

# --- Swap local stores for managed ones (attached resources, §13) ---
#WADI_MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net
#WADI_NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
#WADI_NEO4J_USER=neo4j
#WADI_NEO4J_PASSWORD=change-me

# --- Remote/client mode (CLI on a machine without the stack) ---
#WADI_API_URL=https://wadi.example.dev
#WADI_API_TOKEN=issued-by-your-admin

# --- Analysis behavior ---
# Runs the analyzed repo's build tooling for dependency resolution — arbitrary
# code execution on behalf of that repo. Off by default (§12).
#WADI_FETCH_DEPENDENCIES=false

# --- Local-path analysis ---
# `wadi analyze <path>` mounts this host directory read-only into the
# orchestrator and worker so they can mirror local repos. Defaults to $HOME;
# narrow it to your code directory if you prefer:
#WADI_ANALYZE_MOUNT=/Users/you/projects
