{
  "$defs": {
    "Confidence": {
      "description": "Confidence tiers for recovered facts (\u00a75.4). Ordered EXACT > HIGH > HEURISTIC > NONE.",
      "enum": [
        "exact",
        "high",
        "heuristic",
        "none"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "HttpMethod": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE",
        "PATCH",
        "HEAD",
        "OPTIONS",
        "TRACE"
      ],
      "title": "HttpMethod",
      "type": "string"
    },
    "Provenance": {
      "description": "Where a claim came from (\u00a75.4). Never blended \u2014 every edge/fact carries one.",
      "enum": [
        "machine-proven",
        "config-resolved",
        "heuristic",
        "llm-guessed",
        "human-asserted",
        "federated"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "RemoteEdgeItem": {
      "additionalProperties": false,
      "description": "One stitched edge enriched for display (read-time join over the graph).",
      "properties": {
        "auth_propagation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How auth crosses this call when statically visible \u2014 'authorization-header' | 'feign-interceptor'. See `auth_propagation_state` for WHETHER it crosses: None here no longer has to be read as 'we did not look', because the state says which (\u00a75.2.11 T4 fixed the pass-through idiom this used to miss).",
          "title": "Auth Propagation"
        },
        "auth_propagation_state": {
          "$ref": "#/$defs/TokenPropagation",
          "default": "undetermined",
          "description": "Whether the caller's credentials cross this call (\u00a75.2.11 T4): forwarded | not-forwarded | undetermined. The negative is claimed only where provable, never inferred from silence"
        },
        "caller_service_id": {
          "title": "Caller Service Id",
          "type": "string"
        },
        "caller_service_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caller Service Name"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "external_host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "External Host"
        },
        "http_verb": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mechanism": {
          "title": "Mechanism",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "remote_call_id": {
          "title": "Remote Call Id",
          "type": "string"
        },
        "target_endpoint_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Endpoint Id"
        },
        "target_http_method": {
          "anyOf": [
            {
              "$ref": "#/$defs/HttpMethod"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "target_service_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Service Id"
        },
        "target_service_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Service Name"
        },
        "target_simplified_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Simplified Uri"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "edge_id",
        "remote_call_id",
        "caller_service_id",
        "mechanism",
        "target_kind",
        "confidence",
        "provenance"
      ],
      "title": "RemoteEdgeItem",
      "type": "object"
    },
    "ServiceKind": {
      "description": "v1: service | library. Reserved for Phase 9 (\u00a77): function, edge-worker, firmware.\n\n``library`` (\u00a75.2.6): an in-repo module other services depend on \u2014 never\nanalyzed as a service (no endpoints, no own CPG); its sources join each\ndependent service's staged parse. Recorded so classification is queryable.",
      "enum": [
        "service",
        "library",
        "function",
        "edge-worker",
        "firmware"
      ],
      "title": "ServiceKind",
      "type": "string"
    },
    "SystemGraphService": {
      "additionalProperties": false,
      "description": "One service node on the system map (\u00a711 Phase 2.7 M4).",
      "properties": {
        "async_root_count": {
          "minimum": 0,
          "title": "Async Root Count",
          "type": "integer"
        },
        "cfg_anomaly_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total \u00a75.2.8 anomalies; None = never checked (never conflated with 0)",
          "title": "Cfg Anomaly Count"
        },
        "endpoint_count": {
          "minimum": 0,
          "title": "Endpoint Count",
          "type": "integer"
        },
        "extraction_error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extraction failed \u2014 the node renders as a stated-cause hole (P10)",
          "title": "Extraction Error"
        },
        "gateway": {
          "description": "Has gateway routes or a discovery locator (drawn distinctly)",
          "title": "Gateway",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/ServiceKind"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "service_id": {
          "title": "Service Id",
          "type": "string"
        }
      },
      "required": [
        "service_id",
        "name",
        "kind",
        "endpoint_count",
        "async_root_count",
        "gateway"
      ],
      "title": "SystemGraphService",
      "type": "object"
    },
    "TargetKind": {
      "description": "What a stitched edge lands on (\u00a75.4.2) \u2014 the three target kinds that\nkeep partial coverage honest, plus the explicit undetermined fact (P10).",
      "enum": [
        "analyzed",
        "external",
        "placeholder",
        "undetermined"
      ],
      "title": "TargetKind",
      "type": "string"
    },
    "TokenPropagation": {
      "description": "WHETHER the caller's credentials cross this call (\u00a75.2.11 T4).\n\n``auth_propagation`` names the mechanism when there is one; this says\nwhether there is one at all, and \u2014 the part a nullable string could not\nexpress \u2014 distinguishes \"we proved it does not\" from \"we could not tell\".\nThe difference decides whether a downstream 401 is a finding or a shrug.",
      "enum": [
        "forwarded",
        "not-forwarded",
        "undetermined"
      ],
      "title": "TokenPropagation",
      "type": "string"
    }
  },
  "$id": "https://trywadi.com/schemas/1.24.0/system_graph.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The whole snapshot's service graph in one read (\u00a711 Phase 2.7 M4).\n\n``stitched=False`` means the stitcher has not run: services render,\nand the empty edge list is 'not yet', never 'none' (P10).",
  "properties": {
    "edges": {
      "items": {
        "$ref": "#/$defs/RemoteEdgeItem"
      },
      "title": "Edges",
      "type": "array"
    },
    "services": {
      "items": {
        "$ref": "#/$defs/SystemGraphService"
      },
      "title": "Services",
      "type": "array"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "stitched": {
      "title": "Stitched",
      "type": "boolean"
    }
  },
  "required": [
    "snapshot_id",
    "stitched"
  ],
  "title": "SystemGraphView",
  "type": "object"
}
