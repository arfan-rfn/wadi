{
  "$defs": {
    "DataModelField": {
      "additionalProperties": false,
      "properties": {
        "declared_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "1.26.0: the field's type as written in source, generics kept, e.g. 'List<Release>'. `type_name` stays erased; a JPQL join target resolves through this one, because the element type is the entity the join reaches (\u00a75.2.17)",
          "title": "Declared Type"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = not statically determinable (P10)",
          "title": "Nullable"
        },
        "type_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Name"
        }
      },
      "required": [
        "name"
      ],
      "title": "DataModelField",
      "type": "object"
    },
    "DataModelRelation": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "kind": {
          "description": "e.g. 'one-to-many', 'embedded', 'reference'",
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "target_entity": {
          "minLength": 1,
          "title": "Target Entity",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target_entity"
      ],
      "title": "DataModelRelation",
      "type": "object"
    },
    "EntityDeclaredBy": {
      "description": "How an entity came to be one (Q1, Q15).",
      "enum": [
        "annotation",
        "repository-argument"
      ],
      "title": "EntityDeclaredBy",
      "type": "string"
    }
  },
  "$id": "https://trywadi.com/schemas/1.26.0/data_model.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One persisted entity of one service.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "declared_by": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntityDeclaredBy"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "1.26.0: how this type came to be an entity \u2014 `annotation` (@Entity/@Document) or `repository-argument` (a repository's type argument names it and it carries no annotation, Q1). None = a pre-1.26.0 document, which recorded neither"
    },
    "entity": {
      "description": "Entity/class name, e.g. 'Order'",
      "minLength": 1,
      "title": "Entity",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/DataModelField"
      },
      "title": "Fields",
      "type": "array"
    },
    "id": {
      "pattern": "^dm_[0-9a-f]{16}$",
      "title": "Id",
      "type": "string"
    },
    "jpql_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "1.26.0: the `@Entity(name=...)` value when set \u2014 the name JPQL uses",
      "title": "Jpql Name"
    },
    "persistence_framework": {
      "description": "e.g. 'spring-data-mongodb'",
      "minLength": 1,
      "title": "Persistence Framework",
      "type": "string"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/DataModelRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "schema_version": {
      "default": "1.26.0",
      "title": "Schema Version",
      "type": "string"
    },
    "service_id": {
      "title": "Service Id",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "storage_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Collection/table name where recoverable: `@Table(name=)` or `@Document`. Populated since 1.26.0; native SQL resolves its table names through it (\u00a75.2.17)",
      "title": "Storage Name"
    },
    "type_full_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "1.26.0: the qualified class name, e.g. 'com.acme.orders.Order'. `id` derives from it when the export carries it, so two classes sharing a simple name in one service get two ids (C2). None on a pre-1.26.0 document",
      "title": "Type Full Name"
    }
  },
  "required": [
    "snapshot_id",
    "service_id",
    "id",
    "entity",
    "persistence_framework"
  ],
  "title": "DataModel",
  "type": "object"
}
