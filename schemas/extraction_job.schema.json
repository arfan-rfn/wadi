{
  "$defs": {
    "JobClaim": {
      "additionalProperties": false,
      "properties": {
        "claimed_at": {
          "format": "date-time",
          "title": "Claimed At",
          "type": "string"
        },
        "heartbeat_at": {
          "format": "date-time",
          "title": "Heartbeat At",
          "type": "string"
        },
        "lease_expires_at": {
          "format": "date-time",
          "title": "Lease Expires At",
          "type": "string"
        },
        "worker_id": {
          "minLength": 1,
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "worker_id",
        "claimed_at",
        "lease_expires_at",
        "heartbeat_at"
      ],
      "title": "JobClaim",
      "type": "object"
    },
    "JobStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed"
      ],
      "title": "JobStatus",
      "type": "string"
    },
    "JobType": {
      "enum": [
        "fetch",
        "extract",
        "stitch"
      ],
      "title": "JobType",
      "type": "string"
    }
  },
  "$id": "https://trywadi.com/schemas/1.1.0/extraction_job.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "claim": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobClaim"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "id": {
      "minLength": 1,
      "pattern": "^job_[0-9a-f]{16,32}$",
      "title": "Id",
      "type": "string"
    },
    "max_attempts": {
      "default": 3,
      "minimum": 1,
      "title": "Max Attempts",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "service_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Set for extract jobs; None for fetch/stitch",
      "title": "Service Id"
    },
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/JobStatus",
      "default": "pending"
    },
    "type": {
      "$ref": "#/$defs/JobType"
    }
  },
  "required": [
    "id",
    "type",
    "snapshot_id"
  ],
  "title": "ExtractionJob",
  "type": "object"
}
