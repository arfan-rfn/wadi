{
  "$defs": {
    "BranchCondition": {
      "additionalProperties": false,
      "description": "Branch/loop condition: expression text + operand refs where recoverable (\u00a77).",
      "properties": {
        "expression": {
          "minLength": 1,
          "title": "Expression",
          "type": "string"
        },
        "operands": {
          "items": {
            "$ref": "#/$defs/OperandRef"
          },
          "title": "Operands",
          "type": "array"
        }
      },
      "required": [
        "expression"
      ],
      "title": "BranchCondition",
      "type": "object"
    },
    "IcfgEdge": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/IcfgEdgeKind"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "target": {
          "minLength": 1,
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "kind"
      ],
      "title": "IcfgEdge",
      "type": "object"
    },
    "IcfgEdgeKind": {
      "enum": [
        "flow",
        "true",
        "false",
        "call",
        "return",
        "exception"
      ],
      "title": "IcfgEdgeKind",
      "type": "string"
    },
    "IcfgNode": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "callee": {
          "anyOf": [
            {
              "$ref": "#/$defs/MethodRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "condition": {
          "anyOf": [
            {
              "$ref": "#/$defs/BranchCondition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/IcfgNodeKind"
        },
        "method": {
          "$ref": "#/$defs/MethodRef",
          "description": "Owning method \u2014 the roll-up key (\u00a77)"
        },
        "method_info": {
          "anyOf": [
            {
              "$ref": "#/$defs/MethodInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mq_interaction_id": {
          "anyOf": [
            {
              "pattern": "^mq_[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mq Interaction Id"
        },
        "remote_call_id": {
          "anyOf": [
            {
              "pattern": "^rc_[0-9a-f]{16}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "DEPRECATED (since 1.1.0): first entry of remote_call_ids, kept for readers predating multi-candidate URL slicing. Prefer remote_call_ids.",
          "title": "Remote Call Id"
        },
        "remote_call_ids": {
          "description": "All RemoteCall facts at this call site \u2014 one per sliced candidate URL (\u00a75.2 over-approximation). Order matches the export.",
          "items": {
            "type": "string"
          },
          "title": "Remote Call Ids",
          "type": "array"
        },
        "sink": {
          "anyOf": [
            {
              "$ref": "#/$defs/SinkKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_text": {
          "description": "The node's one-line source text (graph labels are real code)",
          "title": "Source Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "anchor",
        "source_text",
        "method"
      ],
      "title": "IcfgNode",
      "type": "object"
    },
    "IcfgNodeKind": {
      "enum": [
        "entry",
        "exit",
        "statement",
        "branch",
        "loop",
        "call",
        "return"
      ],
      "title": "IcfgNodeKind",
      "type": "string"
    },
    "MethodInfo": {
      "additionalProperties": false,
      "description": "Carried by method entry nodes: signature, typing, docs, behavior badges (\u00a77).",
      "properties": {
        "badges": {
          "description": "Derived behavior badges from tags, e.g. 'touches-db', 'calls-http'",
          "items": {
            "type": "string"
          },
          "title": "Badges",
          "type": "array"
        },
        "doc_comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doc Comment"
        },
        "params": {
          "items": {
            "$ref": "#/$defs/MethodParam"
          },
          "title": "Params",
          "type": "array"
        },
        "return_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Type"
        },
        "signature": {
          "minLength": 1,
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "signature"
      ],
      "title": "MethodInfo",
      "type": "object"
    },
    "MethodParam": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Type Name"
        }
      },
      "required": [
        "name"
      ],
      "title": "MethodParam",
      "type": "object"
    },
    "MethodRef": {
      "additionalProperties": false,
      "description": "Reference to a method: stable content-derived id + human-readable signature.",
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^m_[0-9a-f]{16}$",
          "title": "Id",
          "type": "string"
        },
        "signature": {
          "description": "Fully-qualified method signature",
          "minLength": 1,
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "id",
        "signature"
      ],
      "title": "MethodRef",
      "type": "object"
    },
    "OperandOrigin": {
      "enum": [
        "payload",
        "local",
        "field",
        "config",
        "unknown"
      ],
      "title": "OperandOrigin",
      "type": "string"
    },
    "OperandRef": {
      "additionalProperties": false,
      "description": "A structured reference to one operand of a branch condition.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/OperandOrigin",
          "default": "unknown"
        }
      },
      "required": [
        "name"
      ],
      "title": "OperandRef",
      "type": "object"
    },
    "SinkKind": {
      "description": "Sink classification mirroring the ``sink=`` tag namespace.",
      "enum": [
        "db",
        "http-client",
        "http-client-suspected",
        "mq"
      ],
      "title": "SinkKind",
      "type": "string"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "description": "A file + line range in the text that was actually analyzed.\n\nFor preprocessed files (delombok) the anchor refers to the generated\nvariant \u2014 source-on-demand serves that same text, so anchors and served\nsource stay aligned by construction (\u00a75.3).",
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file": {
          "description": "Path relative to the service build root",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "variant": {
          "$ref": "#/$defs/SourceVariant",
          "default": "original"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "SourceVariant": {
      "description": "Whether an anchor refers to original repo text or a generated variant (\u00a75.3).\n\n``GENERATED`` marks preprocessor output (e.g. delombok'ed Java) \u2014 the text\nthat was actually analyzed, served by source-on-demand with a badge.",
      "enum": [
        "original",
        "generated"
      ],
      "title": "SourceVariant",
      "type": "string"
    }
  },
  "$id": "https://trywadi.com/schemas/1.3.0/icfg.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The assembled ICFG of one endpoint (statement-granularity, coarsened).\n\nThe root is *explicit* (``entry_node_id``), never inferred from topology:\na recursive flow back into the handler would give the root incoming\nedges, so \"the entry with no incoming edges\" is not a sound definition.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/IcfgEdge"
      },
      "title": "Edges",
      "type": "array"
    },
    "endpoint_id": {
      "pattern": "^ep_[0-9a-f]{16}$",
      "title": "Endpoint Id",
      "type": "string"
    },
    "entry_node_id": {
      "description": "The endpoint handler's entry node (explicit root)",
      "minLength": 1,
      "title": "Entry Node Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/IcfgNode"
      },
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "default": "1.3.0",
      "title": "Schema Version",
      "type": "string"
    },
    "service_id": {
      "title": "Service Id",
      "type": "string"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "service_id",
    "endpoint_id",
    "entry_node_id",
    "nodes"
  ],
  "title": "Icfg",
  "type": "object"
}
