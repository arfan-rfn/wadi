{
  "$defs": {
    "Confidence": {
      "description": "Confidence tiers for recovered facts (\u00a75.4). Ordered EXACT > HIGH > HEURISTIC > NONE.",
      "enum": [
        "exact",
        "high",
        "heuristic",
        "none"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "MethodRef": {
      "additionalProperties": false,
      "description": "Reference to a method: stable content-derived id + human-readable signature.",
      "properties": {
        "id": {
          "minLength": 1,
          "pattern": "^m_[0-9a-f]{16}$",
          "title": "Id",
          "type": "string"
        },
        "signature": {
          "description": "Fully-qualified method signature",
          "minLength": 1,
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "id",
        "signature"
      ],
      "title": "MethodRef",
      "type": "object"
    },
    "MqDirection": {
      "enum": [
        "publish",
        "consume"
      ],
      "title": "MqDirection",
      "type": "string"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "description": "A file + line range in the text that was actually analyzed.\n\nFor preprocessed files (delombok) the anchor refers to the generated\nvariant \u2014 source-on-demand serves that same text, so anchors and served\nsource stay aligned by construction (\u00a75.3).",
      "properties": {
        "end_line": {
          "minimum": 1,
          "title": "End Line",
          "type": "integer"
        },
        "file": {
          "description": "Path relative to the service build root",
          "minLength": 1,
          "title": "File",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "title": "Start Line",
          "type": "integer"
        },
        "variant": {
          "$ref": "#/$defs/SourceVariant",
          "default": "original"
        }
      },
      "required": [
        "file",
        "start_line",
        "end_line"
      ],
      "title": "SourceAnchor",
      "type": "object"
    },
    "SourceVariant": {
      "description": "Whether an anchor refers to original repo text or a generated variant (\u00a75.3).\n\n``GENERATED`` marks preprocessor output (e.g. delombok'ed Java) \u2014 the text\nthat was actually analyzed, served by source-on-demand with a badge.",
      "enum": [
        "original",
        "generated"
      ],
      "title": "SourceVariant",
      "type": "string"
    }
  },
  "$id": "https://trywadi.com/schemas/1.20.0/mq_interaction.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One message-queue publish or consume site.",
  "properties": {
    "broker": {
      "description": "e.g. 'kafka', 'rabbitmq'",
      "minLength": 1,
      "title": "Broker",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "direction": {
      "$ref": "#/$defs/MqDirection"
    },
    "id": {
      "pattern": "^mq_[0-9a-f]{16}$",
      "title": "Id",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/MethodRef"
    },
    "schema_version": {
      "default": "1.20.0",
      "title": "Schema Version",
      "type": "string"
    },
    "service_id": {
      "title": "Service Id",
      "type": "string"
    },
    "site": {
      "$ref": "#/$defs/SourceAnchor"
    },
    "snapshot_id": {
      "title": "Snapshot Id",
      "type": "string"
    },
    "topic": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Sliced topic/queue name; None = undetermined (P10)",
      "title": "Topic"
    },
    "topic_confidence": {
      "$ref": "#/$defs/Confidence"
    }
  },
  "required": [
    "snapshot_id",
    "service_id",
    "id",
    "direction",
    "broker",
    "topic_confidence",
    "site",
    "method"
  ],
  "title": "MqInteraction",
  "type": "object"
}
