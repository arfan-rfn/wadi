{
  "$defs": {
    "SnapshotStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed"
      ],
      "title": "SnapshotStatus",
      "type": "string"
    }
  },
  "$id": "https://trywadi.com/schemas/1.19.0/snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One analysis run's frozen commit-set (\u00a74). Immutable once created.",
  "properties": {
    "commits": {
      "additionalProperties": {
        "type": "string"
      },
      "description": "Normalized repo source -> resolved commit SHA at kickoff",
      "minProperties": 1,
      "title": "Commits",
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "id": {
      "minLength": 1,
      "pattern": "^snap_[0-9a-f]{16,32}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.19.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "status": {
      "$ref": "#/$defs/SnapshotStatus",
      "default": "pending"
    },
    "system_id": {
      "minLength": 1,
      "title": "System Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "system_id",
    "commits"
  ],
  "title": "Snapshot",
  "type": "object"
}
